# Port for the express server
PORT=5000

# MongoDB Connection String (Atlas SRV or Local URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/crm_db

# Secret key used for signing JSON Web Tokens
JWT_SECRET=your_secure_random_jwt_secret_key_here

# JWT Expiration time (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# Node environment setting
NODE_ENV=production

# Production URL of your frontend application (used for CORS validation)
FRONTEND_URL=https://startup-crm-lite-navyasreethatigutla-7037s-projects.vercel.app
